<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>Dacke's Common Paging</Title>
    <Version>1.0.4</Version>
    <PackageIcon>efcorepaginglogo.png</PackageIcon>
    <Description>Provides shared core contracts, models, and abstractions for pagination, dynamic multi-condition filtering, sorting rules, etc.</Description>
    <RepositoryUrl>https://github.com/Dacke/EFCorePaging</RepositoryUrl>
    <PackageTags>Entity Framework, EFCore, Paging, Common, Dapper</PackageTags>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\assets\efcorepaginglogo.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="readme.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
