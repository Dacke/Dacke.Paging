<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>Entity Framework Core Common Paging</Title>
    <Version>1.0.2</Version>
    <PackageIcon>efcorepaginglogo.png</PackageIcon>
    <Description>Provides shared core contracts, models, and abstractions for pagination, dynamic multi-condition filtering, sorting rules, and request/response wrappers across Entity Framework Core and data access layers</Description>
    <RepositoryUrl>https://github.com/Dacke/EFCorePaging</RepositoryUrl>
    <PackageTags>Entity Framework, EFCore, Paging, Common</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\assets\efcorepaginglogo.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
