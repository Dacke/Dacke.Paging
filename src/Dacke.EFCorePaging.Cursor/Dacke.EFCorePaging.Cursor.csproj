<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Version>1.0.5</Version>
    <Title>Dacke's Entity Framework Core Cursor Paging</Title>
    <PackageIcon>efcorepaginglogo.png</PackageIcon>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <Description>Cursor pagination relies on unique record pointers rather than numerical offsets. The client requests a specific window of data by sending an opaque reference token (`Cursor` / `After`) representing the boundary of the last seen record, alongside the number of records to fetch (`Take` / `PageSize`).</Description>
    <PackageTags>Entity Framework, EFCore, Paging, Cursor</PackageTags>
    <RepositoryUrl>https://github.com/Dacke/Dacke.Paging</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\assets\efcorepaginglogo.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dacke.Paging.Common\Dacke.Paging.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="readme.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
