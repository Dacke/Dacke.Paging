<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>Dacke's Dapper Offset Paging</Title>
    <Version>1.0.5</Version>
    <Description>High-performance Dapper extension methods for offset-based pagination (Skip/Take), sorting, and SQL parameterization.</Description>
    <PackageIcon>dapperpaginglogo.png</PackageIcon>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Dacke/Dacke.Paging</RepositoryUrl>
    <PackageId>$(AssemblyName)</PackageId>
    <PackageTags>Dapper, Paging, Offset</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\assets\dapperpaginglogo.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dacke.Paging.Common\Dacke.Paging.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="readme.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
